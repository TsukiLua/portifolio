# URL pública do site (usada em metadados de compartilhamento e sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3004
# Número de WhatsApp do negócio (DDD + número). Vazio = o link abre o WhatsApp para o visitante escolher o contato.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# "true" libera indexação por buscadores. Demonstrações ficam com noindex por padrão.
NEXT_PUBLIC_ALLOW_INDEXING=false
