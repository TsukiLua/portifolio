# URL pública do portfólio (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
# WhatsApp profissional: DDD + número, só dígitos (ex.: 11999999999). Vazio = o WhatsApp abre e o visitante escolhe o contato.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# "true" libera buscadores. Ative só depois de preencher src/data/profile.ts e publicar no domínio final.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Links das demonstrações publicadas (um projeto Vercel por site). Sem URL, o botão "Abrir demonstração" não aparece.
NEXT_PUBLIC_DEMO_URL_VEICULOS=
NEXT_PUBLIC_DEMO_URL_BARBEARIA=
NEXT_PUBLIC_DEMO_URL_CATALOGO=
NEXT_PUBLIC_DEMO_URL_ESTUDIO=
NEXT_PUBLIC_DEMO_URL_SERVICOS=
